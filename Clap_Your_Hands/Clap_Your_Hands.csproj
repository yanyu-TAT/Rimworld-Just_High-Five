<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Clap_Your_Hands</AssemblyName>
    <RootNamespace>ClapYourHands</RootNamespace>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 构建产物直出 mod 目录下的 Assemblies/，供游戏直接加载 -->
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- 游戏程序集路径：RimWorld 1.7 起原版程序集位于游戏根目录，可用 -p:RimWorldDir=... 覆盖 -->
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">D:\steam\steamapps\common\RimWorld</RimWorldDir>
    <!-- 兼容旧参数 RimWorldManagedDir -->
    <RimWorldDir Condition="'$(RimWorldManagedDir)' != ''">$(RimWorldManagedDir)</RimWorldDir>
  </PropertyGroup>

  <!-- 只保留最小必需引用：原版代码 + Unity 兼容桩（零第三方依赖） -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Defs / Languages 中不放 C# 源码，避免被默认 glob 收编 -->
  <ItemGroup>
    <Compile Remove="Assemblies\**" />
    <Compile Remove="Patches\**" />
    <EmbeddedResource Remove="Assemblies\**" />
    <None Remove="Assemblies\**" />
  </ItemGroup>

</Project>
