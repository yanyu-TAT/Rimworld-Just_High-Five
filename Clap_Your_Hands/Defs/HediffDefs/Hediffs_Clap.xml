<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 完美击掌的 12 小时随机增益。severity = 等级（1/2/3），时长由 HediffComp_Disappears 承载。 -->
  <HediffDef>
    <defName>Clap_Buff</defName>
    <label>high five rush</label>
    <description>A surge of energy from a perfect high-five.</description>
    <hediffClass>ClapYourHands.Hediff_ClapBuff</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>Lv1</label>
        <statFactors>
          <WorkSpeedGlobal>1.10</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MoveSpeed>0.1</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>Lv2</label>
        <statFactors>
          <WorkSpeedGlobal>1.25</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MoveSpeed>0.2</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>Lv3</label>
        <statFactors>
          <WorkSpeedGlobal>1.50</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- 击掌冷却载体（24 小时），不出现在健康列表。 -->
  <HediffDef>
    <defName>Clap_Cooldown</defName>
    <label>high five cooldown</label>
    <description>Already shared a high-five recently.</description>
    <hediffClass>ClapYourHands.Hediff_ClapCooldown</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

</Defs>
